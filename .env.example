# Development variables (tech doc 6.4). Copy to .env.local; never commit .env.local.
# API keys are NEVER set here: enter them in Settings (stored in the OS keychain).
SIDEKICK_LOG=info
# SIDEKICK_DATA_DIR=./.dev-data
SIDEKICK_MOCK_PROVIDERS=0
# SIDEKICK_AUDIO_FIXTURE=tests/fixtures/audio/standup.wav
SIDEKICK_DISABLE_EXCLUSION=0
