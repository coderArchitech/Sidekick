{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "Overlay window: sessions, capture, retrieval, answers, notes and overlay controls (tech doc 5.8). Never key commands.",
  "windows": ["overlay"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-app-info",
    "allow-get-settings",
    "allow-open-settings",
    "allow-get-capture-protection",
    "allow-llm-stream",
    "allow-cancel-stream",
    "allow-record-latency",
    "allow-create-session",
    "allow-web-search",
    "allow-session-provider-options",
    "allow-confirm-consent",
    "allow-start-session",
    "allow-pause-session",
    "allow-resume-session",
    "allow-end-session",
    "allow-delete-session",
    "allow-list-sessions",
    "allow-get-transcript",
    "allow-rename-speaker",
    "allow-add-bookmark",
    "allow-set-auto-answer",
    "allow-save-answer",
    "allow-rate-answer",
    "allow-list-answers",
    "allow-list-skills",
    "allow-set-session-skill",
    "allow-set-session-extra-skills",
    "allow-set-overlay",
    "allow-set-click-through",
    "allow-get-click-through",
    "allow-set-session-retention",
    "allow-log",
    "allow-get-notes",
    "allow-save-notes",
    "allow-save-summary",
    "allow-set-agenda",
    "allow-update-agenda",
    "allow-set-action-item-done",
    "allow-capture-screenshot",
    "allow-list-windows",
    "allow-preview-screen",
    "allow-list-screenshots",
    "allow-screenshot-image",
    "allow-delete-screenshot",
    "allow-ingest-document",
    "allow-ingest-url",
    "allow-list-documents",
    "allow-delete-document",
    "allow-list-packs",
    "allow-list-session-packs",
    "allow-set-session-packs",
    "allow-brief-material",
    "allow-get-brief",
    "allow-save-brief",
    "allow-retrieve-context",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top"
  ]
}
