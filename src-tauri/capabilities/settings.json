{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Settings window: providers, keys, models, settings, skills, Knowledge Packs, usage, diagnostics, backup (tech doc 5.8). The only window that can touch API keys.",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "allow-app-info",
    "allow-get-settings",
    "allow-update-settings",
    "allow-list-providers",
    "allow-set-api-key",
    "allow-test-api-key",
    "allow-delete-api-key",
    "allow-list-models",
    "allow-whisper-models",
    "allow-download-whisper-model",
    "allow-list-skills",
    "allow-skill-templates",
    "allow-check-skill",
    "allow-save-skill",
    "allow-set-skill-enabled",
    "allow-delete-skill",
    "allow-import-skill",
    "allow-export-skill",
    "allow-delete-all-data",
    "allow-create-pack",
    "allow-rename-pack",
    "allow-delete-pack",
    "allow-list-packs",
    "allow-list-pack-documents",
    "allow-ingest-pack-document",
    "allow-ingest-pack-url",
    "allow-delete-document",
    "allow-log",
    "allow-export-logs",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-get-diagnostics"
  ]
}
